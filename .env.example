# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# The Claude API is the ONLY paid component in SCRAG (billed per token, no free
# tier). The anthropic SDK reads this variable automatically, so a bare
# Anthropic() client works once it is set.
ANTHROPIC_API_KEY=

# Optional overrides. Leave blank to use the defaults in config.py.
SCRAG_GENERATOR_MODEL=
SCRAG_EMBEDDING_MODEL=
SCRAG_DATA_DIR=
